# 블로그 CLI 전용 예시 파일. 실제 키는 .env.publish 에 넣고 커밋하지 마세요. (.env.publish 는 .gitignore 됨)

# --- Supabase (발행 + Notion 동기화 공용) ---
# Supabase 대시보드 > Project Settings > API 에서 복사
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role 키 (RLS 우회). 서버/CLI 에서만 사용. 프론트엔드에 절대 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Notion 동기화 (scripts/notion-sync.mjs) ---
# https://www.notion.so/my-integrations 에서 통합 생성 후 "Internal Integration Secret" 복사
NOTION_TOKEN=secret_xxx
# 블로그 DB URL 의 32자리 id: notion.so/<워크스페이스>/<이 부분>?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
